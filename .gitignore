!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env
.env*.local
dev.db
dev.db-journal
src/generated/

# Приложенные к сообщениям файлы. В репозитории им не место.
uploads/
