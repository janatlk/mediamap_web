// Что поменяли против старой схемы и зачем:
//   * Marker → Report. На странице это случай, а в системе — сообщение со
//     своим жизненным циклом.
//   * isApproved (bool) → status. Отклонённое было не отличить от ещё не
//     рассмотренного, и человек не мог узнать решение.
//   * Появился publicId вида MM-2026-0142 — то, что называют по телефону.
//     Внутренний id для этого не годится.
//   * Роль получила фиксированный набор. Раньше приезжала прямо из тела
//     запроса — регистрируйся администратором кто хочешь.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Адрес базы — в prisma.config.ts и в адаптере: с Prisma 7 в схеме нельзя.
datasource db {
  provider = "sqlite"
}

// Enum тут нет: SQLite их не умеет, а дев идёт на нём (Postgres будет на
// сервере). Роль, статус и тяжесть — строки, допустимые значения лежат в
// src/lib/enums.ts. При переезде на Postgres колонки те же.

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?

  /// Пусто у тех, кто вошёл через Google или Facebook: пароля у них нет.
  passwordHash String?

  /// REPORTER | MODERATOR | ADMIN | SUPERADMIN — см. src/lib/enums.ts.
  /// По умолчанию REPORTER: кто заводит аккаунт сам, сотрудником не станет.
  role String @default("REPORTER")

  /// Писать ли на почту, когда по заявке приняли решение.
  ///
  /// По умолчанию да: человек оставил почту и подал заявку — узнать, чем она
  /// кончилась, он и хотел. Это извещение о его собственном обращении, а не
  /// рассылка, и выключается оно одной галкой в профиле.
  notifyByEmail Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewed Report[]  @relation("ReviewedBy")
  reported Report[]  @relation("ReportedBy")
  sessions Session[]
  accounts Account[]

  /// Оценки источников, которые поставил этот сотрудник.
  decidedSources Source[]

  @@map("users")
}

/// Вход через чужой сервис.
///
/// Отдельной таблицей, а не колонками в User: у одного человека может быть
/// и Google, и Facebook, и пароль — всё разом, и заводить под каждый способ
/// по колонке значит переписывать таблицу на каждый новый сервис.
model Account {
  id       Int    @id @default(autoincrement())
  /// google | facebook
  provider String
  /// Идентификатор человека у этого сервиса.
  externalId String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, externalId])
  @@index([userId])
  @@map("accounts")
}

/// Сессия в базе, а не токен в заголовке — так доступ можно отозвать,
/// не заставляя менять пароль.
model Session {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

/// Только опознание и порядок. Все слова — названия, описания, правовая
/// основа — лежат в словаре по этому же slug: держать половину текста в
/// базе, а половину в словаре значит однажды их развести.
model ViolationType {
  id   Int    @id @default(autoincrement())
  slug String @unique
  /// Порядок в списках. Без него всё выстраивается по id, а он случайный.
  sort Int    @default(0)

  reports Report[]

  @@map("violation_types")
}

model Report {
  id       Int    @id @default(autoincrement())
  /// Публичный номер обращения: MM-2026-0142.
  publicId String @unique

  /// Личный ключ для страницы «сообщение принято».
  ///
  /// Номер вида MM-2026-0001 угадывается с первой попытки, а сообщение до
  /// проверки не опубликовано — по номеру открывать его нельзя. Ключ
  /// случайный, знает его только тот, кто подавал. По нему же он потом
  /// посмотрит решение.
  ///
  /// У перенесённых из старой базы сообщений ключа нет и взяться ему неоткуда.
  receiptToken String? @unique

  /// Необязательны: карту убрали, привязка к месту редкая, требовать её
  /// от человека незачем.
  lat Float?
  lng Float?

  /// Код области: chuy, osh, talas, issyk-kul, naryn, jalal-abad, batken.
  /// Строкой хранить название нельзя — оно переводится.
  regionCode String?
  city       String?

  mediaLink        String?
  authorComment    String?

  /// Чей это материал. Проставляется при подаче по ссылке; пусто, если
  /// ссылки не было или из неё ничего не вычиталось.
  sourceId Int?
  source   Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  /// Короткий заголовок случая для списка и карточки.
  ///
  /// Черновик пишет модель при подаче, окончательный текст — проверяющий.
  /// Без него в списке у всех случаев одного вида был один и тот же
  /// заголовок («Язык вражды»), и понять, что произошло, можно было только
  /// открыв карточку.
  ///
  /// Пусто у старых записей и у тех, где модель не нашла что сказать —
  /// тогда показываем название вида, как раньше.
  headline         String?

  /// Имя файла из старой системы: "c0b772af-….jpg". Самих файлов у нас нет,
  /// они остались на прежнем сервере. Колонку держим, чтобы не потерять
  /// ссылку, если их когда-нибудь перенесут. Новые снимки сюда не пишем —
  /// для них есть Attachment.
  screenshot       String?
  moderatorComment String?

  /// PENDING | APPROVED | REJECTED
  status   String  @default("PENDING")

  /// Предварительная оценка, снимается сразу при подаче.
  ///
  /// Она ничего не решает: статус ставит только живой человек. Оценка
  /// нужна, чтобы очередь на проверку шла не подряд, а с самого похожего
  /// на настоящее нарушение.
  ///
  /// aiSource говорит, чем получена: rules — разбор по ключевым словам,
  /// model — языковая модель. Без этого поля через полгода не понять, чему
  /// верить в старых записях.
  aiVerdict     String?
  aiConfidence  Float?
  aiSummary     String?
  aiSource      String?
  aiCheckedAt   DateTime?
  /// Ответ модели по каждому виду в отдельности, объектом JSON: ключ — вид
  /// нарушения, значение — найден ли он, с какой уверенностью и почему.
  ///
  /// Заявитель выбирает вид сам, и отвечать ему надо про этот вид, а не про
  /// тот, который модель проверила первым. Отсутствие вида в объекте значит
  /// «не проверяли» — это не то же самое, что «проверили и не нашли».
  ///
  /// JSON-строкой, а не таблицей: читается всегда целиком и только вместе с
  /// сообщением, искать по нему нечего.
  aiTypeChecks  String?

  /// Что модель вычитала с приложенной картинки.
  ///
  /// Когда к сообщению приложен снимок, разбор идёт по нему, а не по рассказу
  /// заявителя — и весь вердикт держится на тексте, который модель с этого
  /// снимка списала. Не сохранить его значит оставить проверяющего с выводом,
  /// основания которого он не может увидеть.
  aiExtractedText String?

  /// По чему судила модель: image | link | story.
  ///
  /// Раньше это выводили из того, есть ли извлечённый текст. Пока картинки
  /// были единственным внешним источником, догадка работала; со ссылками —
  /// уже нет, а заявителю мы говорим об этом прямым текстом на странице.
  aiBasis String?

  /// Решение проверяющего поверх оценки модели.
  ///
  /// Отдельными колонками, а не правкой ai*: там лежит то, что сказала
  /// модель, и это единственный след, по которому потом считают, часто ли
  /// она ошибается. Затри его правкой человека — и вопрос «можно ли ей
  /// верить» станет неотвечаемым, потому что все записи окажутся верными.
  ///
  /// Пусто, пока проверяющий ничего не менял: тогда показываем оценку модели.
  reviewVerdict    String?
  reviewConfidence Float?
  reviewSummary    String?
  /// LOW | MEDIUM | HIGH. Пусто, пока заявку не рассмотрели.
  severity String?

  violationTypeId Int
  violationType   ViolationType @relation(fields: [violationTypeId], references: [id])

  /// Кто подал, если человек был в аккаунте. Пусто у анонимных — а это
  /// основной путь, и таким он остаётся.
  authorId Int?
  author   User? @relation("ReportedBy", fields: [authorId], references: [id], onDelete: SetNull)

  /// Кто рассмотрел. Проверивший сотрудник после решения есть всегда.
  reviewedById Int?
  reviewedBy   User?     @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  attachments Attachment[]
  aiChecks    AiCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([violationTypeId])
  @@map("reports")
}

/// Снимок экрана или запись, приложенные к сообщению.
///
/// Отдельной таблицей, а не колонкой: снимков бывает несколько, и колонка
/// screenshot это уже не вмещала. Заодно к файлу нужно знать тип и размер —
/// в строке с путём этого не сохранить.
///
/// Самих файлов в базе нет, только ключ хранилища. Складывать двадцать
/// мегабайт видео в SQLite — способ получить базу, которую нельзя открыть.
/// Источник: аккаунт, канал или издание, о котором к нам приходят сообщения.
///
/// Заводится сам, когда в сообщении есть ссылка: разбор адреса в
/// src/lib/platforms.ts достаёт площадку и имя аккаунта. Заводится в
/// состоянии UNKNOWN — то есть «просто встретился», без всякой оценки.
/// Оценку ставит человек.
///
/// key — то, по чему источник узнаётся при следующей встрече. Собирается из
/// устойчивого номера, если площадка его показала, иначе из имени. Разница
/// принципиальная: у источника с номером переименование видно сразу, у
/// источника с именем переименовавшийся аккаунт приезжает как новый, и
/// связать их может только проверяющий.
model Source {
  id  Int    @id @default(autoincrement())
  key String @unique

  /// instagram | facebook | tiktok | youtube | telegram | twitter | vk |
  /// odnoklassniki | web — см. src/lib/platforms.ts.
  platform String

  /// Номер аккаунта у площадки. Есть редко, но если есть — не меняется.
  externalId String?

  /// Имя, под которым аккаунт известен сейчас. История — в SourceHandle.
  handle String?

  /// Домен. У источников без имени он единственное, что о них известно.
  host String

  /// Как называет себя аккаунт: «Кактус медиа». Тоже меняется.
  displayName String?

  /// UNKNOWN | TRUSTED | WATCH | UNTRUSTED — см. src/lib/enums.ts.
  ///
  /// По умолчанию UNKNOWN, и это не то же самое, что «сомнительный».
  /// Встреченный один раз аккаунт не обвинён ни в чём.
  status String @default("UNKNOWN")

  /// Чем решение обосновано. Без него запись в чёрном списке — это слух:
  /// через полгода никто не вспомнит, за что аккаунт туда попал.
  reason String?

  /// Кто поставил оценку и когда. Решение всегда чьё-то, а не «системы».
  decidedById Int?
  decidedBy   User? @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handles SourceHandle[]
  reports Report[]

  @@index([status])
  @@index([platform])
  @@map("sources")
}

/// История имён одного источника: что и когда мы у него видели.
///
/// Ради этого реестр и заводился. Аккаунт, у которого имя меняется четыре
/// раза за месяц, — сам по себе повод присмотреться, даже если каждое
/// отдельное имя ни о чём не говорит.
///
/// firstSeenAt и lastSeenAt, а не одна дата: имя может вернуться обратно,
/// и «видели с марта по май, потом снова в августе» честнее, чем две
/// одинаковые строки.
model SourceHandle {
  id       Int    @id @default(autoincrement())
  sourceId Int
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// HANDLE — имя в адресе, NAME — как аккаунт подписан.
  kind  String @default("HANDLE")
  value String

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  /// Откуда узнали: link — из ссылки в сообщении, manual — вписал человек.
  origin String @default("link")

  @@unique([sourceId, kind, value])
  @@index([value])
  @@map("source_handles")
}

model Attachment {
  id String @id @default(cuid())

  reportId Int
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// IMAGE | VIDEO — см. src/lib/enums.ts.
  kind String
  /// Тип из заголовка файла, уже проверенный по белому списку.
  mime String
  /// Размер в байтах. Держим у себя, чтобы не ходить в хранилище ради подписи.
  size Int
  /// Имя, с которым файл пришёл. Показываем человеку; путь из него не строим.
  name String
  /// Ключ в хранилище. Сейчас это путь на диске, потом станет ключом в R2 —
  /// снаружи этой строки его формат не знает никто.
  key String

  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("attachments")
}

model NewsItem {
  id          Int      @id @default(autoincrement())
  guid        String   @unique
  title       String
  link        String
  snippet     String?
  source      String
  publishedAt DateTime

  translations NewsTranslation[]

  @@index([publishedAt])
  @@map("news")
}

/// Переводы новостей, сделанные моделью.
///
/// Перевод стоит секунд процессорного времени, а заметку на кыргызском
/// откроют десять человек подряд. Считать её десять раз незачем: текст
/// новости не меняется, и один раз переведённое годится навсегда.
///
/// model — чем переведено. Сменится модель — старые переводы можно будет
/// отличить и пересчитать, не гадая, откуда взялся текст.
model NewsTranslation {
  id     Int @id @default(autoincrement())
  newsId Int
  news   NewsItem @relation(fields: [newsId], references: [id], onDelete: Cascade)

  /// Код языка перевода: ky, en, tr…
  lang    String
  title   String
  snippet String?
  model   String

  createdAt DateTime @default(now())

  @@unique([newsId, lang])
  @@map("news_translations")
}

/// Тексты, которые правит администратор. Ключ повторяет путь в словаре:
/// home.title.
model SiteText {
  key      String @id
  valueRu  String
  valueKy  String
  category String @default("general")

  updatedAt DateTime @updatedAt

  @@map("site_texts")
}

/// Журнал предварительных оценок — по одной строке на каждую попытку.
///
/// Зачем отдельная таблица, если в Report уже есть поля aiVerdict и прочие.
/// Там лежит текущая оценка, одна и последняя. А чтобы отвечать на вопрос
/// «можно ли этой модели верить», нужна история: сколько раз сервис не
/// ответил, сколько времени занимал, что именно сказал и совпало ли это с
/// решением проверяющего. Перезаписываемая колонка такого не помнит.
///
/// Сюда пишутся и неудачи (ok = false): без них частота отказов неизвестна,
/// а именно она первой показывает, что с моделью что-то не так.
model AiCheck {
  id Int @id @default(autoincrement())

  /// Пусто, если запись не создалась — например, оценка снималась, а
  /// сохранение сообщения потом сорвалось.
  reportId Int?
  report   Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// rules — разбор по ключевым словам, model — языковая модель.
  source String
  /// "llm-hate:gpt-5.6-luna + llm-disinfo:…" — из ответа сервиса.
  model  String?

  /// Что ответили. У неудачи пусто.
  verdict    String?
  confidence Float?
  /// Направление вражды или подвид дезинформации.
  sublabel   String?
  /// insult | discrimination | incitement.
  act        String?

  /// Утверждение, которое модель предложила проверить, и итог проверки
  /// по источникам: true | false | unverified.
  claim       String?
  factVerdict String?
  /// Ссылки на источники, через перенос строки. Массивов в SQLite нет.
  sources     String?

  /// Что выбрал заявитель — чтобы считать расхождения, не заглядывая в Report.
  chosenType String?

  /// Сколько заняло, включая скачивание медиа. Отдельно от createdAt:
  /// по нему видно, когда сервис начал тормозить.
  latencyMs Int?

  ok    Boolean @default(true)
  /// Текст ошибки, если не ответил. Короткий: нам нужен вид сбоя, не трасса.
  error String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
  @@index([ok])
  @@map("ai_checks")
}
